# skembed: a missing archive gives an empty array, three bytes give "65,66,67" and size 3.
file(REMOVE ${OUT}/none.c ${OUT}/abc.c)
execute_process(COMMAND ${SKEMBED} ${OUT}/does-not-exist.dat ${OUT}/none.c RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "skembed failed on a missing file")
endif()
file(READ ${OUT}/none.c none)
if(NOT none MATCHES "sk_embedded_size = 0;")
  message(FATAL_ERROR "missing file: no empty array")
endif()
file(WRITE ${OUT}/abc.dat "ABC")
execute_process(COMMAND ${SKEMBED} ${OUT}/abc.dat ${OUT}/abc.c RESULT_VARIABLE rc)
file(READ ${OUT}/abc.c abc)
if(NOT rc EQUAL 0 OR NOT abc MATCHES "sk_embedded_size = 3;" OR NOT abc MATCHES "65,66,67,")
  message(FATAL_ERROR "three bytes: wrong array")
endif()
